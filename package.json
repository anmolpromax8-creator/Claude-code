{
  "name": "ccode-ai",
  "version": "0.2.4",
  "description": "Original open-source agentic coding assistant CLI with persistent API keys, improved terminal TUI, slash commands, and NVIDIA NIM support.",
  "type": "module",
  "bin": {
    "ccode": "dist/index.js",
    "ccode-ai": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "ai",
    "developer-tools"
  ],
  "author": "anmolpromax8-creator",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anmolpromax8-creator/Claude-code.git"
  },
  "homepage": "https://github.com/anmolpromax8-creator/Claude-code#readme",
  "bugs": {
    "url": "https://github.com/anmolpromax8-creator/Claude-code/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
